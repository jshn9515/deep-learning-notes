---
config:
  startOnLoad: false
  theme: base
  htmlLabels: false
  fontFamily: Arial, Microsoft YaHei, Noto Serif CJK SC, sans-serif
  themeVariables:
    fontSize: 14px
    primaryColor: "#e9f2fc"
    primaryBorderColor: "#296bb7"
    primaryTextColor: "#333333"
    lineColor: "#0b0b0b"

  themeCSS: |
    .node text,
    .nodeLabel,
    .label text {
      font-weight: 400;
      font-style: normal;
    }

    .node rect,
    .flowchart-link {
      stroke-width: 1px;
    }
---

flowchart TD
    M[Less activation memory]

    M --> GA[Gradient Accumulation]
    M --> AC[Activation Checkpointing]

    GA --> GA1[Use a smaller micro-batch]
    GA1 --> GA2[Reduce batch-dimension activations]

    AC --> AC1[Save fewer forward intermediates]
    AC1 --> AC2[Reduce per-micro-batch activations]
